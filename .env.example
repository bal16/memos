# Vercel project environment variables (do NOT commit real values)

# Neon PostgreSQL (pooled connection string)
# Example: postgres://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
MEMOS_DSN=

# Memos server
MEMOS_DRIVER=postgres
MEMOS_MODE=prod
MEMOS_PORT=5230
PORT=5230

# Neon Object Storage (S3-compatible) is configured in Memos Admin UI (Settings > Storage),
# not via container env vars:
# - Storage Type: S3
# - Endpoint, Region (e.g. ap-southeast-1), Bucket
# - Access Key ID, Secret Access Key

# Client / CLI (memo-quick, Moe Memos) - keep real values out of git
# Example: https://your-memos.vercel.app
MEMOS_URL=
# Personal Access Token (secret) - treat like a password
MEMOS_TOKEN=
