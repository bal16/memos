#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
MEMO_QUICK="${MEMO_QUICK_BIN:-$SCRIPT_DIR/memo-quick}"
if [[ ! -x "$MEMO_QUICK" ]] && command -v memo-quick >/dev/null 2>&1; then
  MEMO_QUICK="$(command -v memo-quick)"
fi

tmp="$(mktemp --suffix=.md /tmp/memo-XXXXXX)"
cleanup() { rm -f "$tmp"; }
trap cleanup EXIT

# Open Neovim in Insert Mode, Markdown filetype. Write (:w / :wq) saves temp file;
# after exit, non-empty content is sent via memo-quick.
"${EDITOR_NVIM:-nvim}" \
  -c 'setlocal filetype=markdown buftype= nobuflisted' \
  -c 'startinsert' \
  "$tmp"

if [[ -s "$tmp" ]]; then
  "$MEMO_QUICK" < "$tmp"
fi
