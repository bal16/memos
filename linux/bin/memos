#!/usr/bin/env bash
set -euo pipefail

LOG_TAG="memos"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/memo-quick"
ENV_FILE="$CONFIG_DIR/env"
NOTES_DIR_DEFAULT="${HOME}/notes/memos"

# shellcheck disable=SC1090
[[ -f "$ENV_FILE" ]] && source "$ENV_FILE"

MEMOS_URL="${MEMOS_URL:-}"
MEMOS_TOKEN="${MEMOS_TOKEN:-}"
MEMOS_VISIBILITY="${MEMOS_VISIBILITY:-PRIVATE}"
MEMOS_API_PATH="${MEMOS_API_PATH:-}"
MEMOS_DEBUG="${MEMOS_DEBUG:-0}"
NOTES_DIR="${MEMOS_NOTES_DIR:-$NOTES_DIR_DEFAULT}"
MIRROR_DIR="$NOTES_DIR/notes"
SYNC_DIR="$NOTES_DIR/.sync"
STATE_FILE="$SYNC_DIR/state.json"
QUEUE_FILE="$NOTES_DIR/.queue.jsonl"

usage() {
  cat << 'EOF'
Usage:
  memos                      Open Neovim scratchpad and create a new note
  memos new [text...]        Create a new note (editor if no text/stdin, else quick)
  memos add [text...]        Quick-create a new note from args or stdin
  memos quick [text...]      Alias for quick-create
  memos "text"               Shorthand quick-create (unknown non-command arg)
  echo "text" | memos new    Create a new note from stdin

  memos list [--remote]      List notes (local mirror by default)
  memos read <ref>           Show a note (uid/name/filename/prefix match)
  memos edit <ref>           Edit a note locally and push update
  memos rm <ref>             Delete a note (alias: delete)
  memos conflicts            List notes with sync conflicts
  memos resolve <ref> --keep-local|--keep-remote
                             Resolve a conflict (push local or take remote)
  memos pull                 Pull remote memos into local mirror
  memos push                 Push local changes (dirty notes + queue), no pull
  memos sync                 Reconcile: push local changes + pull
  memos flush                Flush outbound queue only

  memos completion <shell>   Print shell completion script (bash|zsh|fish)
  memos help|-h|--help       Show this help

Compatibility: memo-quick and memo-nvim are wrappers around this command.

Environment (~/.config/memo-quick/env):
  MEMOS_URL        Base URL, e.g. https://memos.example.com
  MEMOS_TOKEN      Personal Access Token (Bearer)
  MEMOS_VISIBILITY PRIVATE|PROTECTED|PUBLIC (default: PRIVATE)
  MEMOS_API_PATH   Optional fixed API base path (e.g. /api/memos or /api/v1/memos)
  MEMOS_NOTES_DIR  Local root dir (default: ~/notes/memos)

Storage:
  notes/*.md       Per-note mirror files (frontmatter + content)
  .sync/state.json Sync state and id mapping
  .queue.jsonl     Outbound operation queue
EOF
}

notify() {
  local msg="$1"
  if command -v notify-send > /dev/null 2>&1; then
    notify-send -a "$LOG_TAG" "$LOG_TAG" "$msg" > /dev/null 2>&1 || true
  fi
}

die() {
  echo "$*" >&2
  exit 1
}

debug() {
  [[ "${MEMOS_DEBUG:-0}" == "1" ]] && echo "[debug] $*" >&2 || true
}

need_tools() {
  command -v jq > /dev/null 2>&1 || die "jq is required"
  command -v curl > /dev/null 2>&1 || die "curl is required"
}

ensure_dirs() {
  mkdir -p "$NOTES_DIR" "$MIRROR_DIR" "$SYNC_DIR" "$CONFIG_DIR"
  [[ -f "$STATE_FILE" ]] || printf '{"version":1,"notes":{}}\n' > "$STATE_FILE"
}

base_url() {
  printf '%s' "${MEMOS_URL%/}"
}

api_paths() {
  if [[ -n "$MEMOS_API_PATH" ]]; then
    printf '%s\n' "${MEMOS_API_PATH%/}"
  else
    # API roots: collection/resource paths are appended as suffix (e.g. /memos, /memos/<id>)
    printf '%s\n' "/api" "/api/v1"
  fi
}

# curl wrapper: prints "HTTP_CODE" on last line via caller; body to stdout file
http_request() {
  local method="$1" path="$2" out="$3" data="${4:-}"
  local url
  url="$(base_url)$path"
  local args=(-sS -o "$out" -w '%{http_code}' -X "$method" "$url" -H "Authorization: Bearer ${MEMOS_TOKEN}")
  if [[ -n "$data" ]]; then
    args+=(-H "Content-Type: application/json" -d "$data")
  fi
  curl "${args[@]}" 2> /dev/null || printf '000'
}

api_try() {
  # usage: api_try METHOD suffix data_or_empty -> sets REPLY_CODE REPLY_BODY REPLY_PATH REPLY_BASE
  local method="$1" suffix="$2" data="${3:-}" out
  out="$(mktemp /tmp/memos-api.XXXXXX)"
  # shellcheck disable=SC2034
  REPLY_CODE="000"
  REPLY_BODY=""
  # shellcheck disable=SC2034
  REPLY_PATH=""
  # shellcheck disable=SC2034
  REPLY_BASE=""
  local path code
  while IFS= read -r path; do
    debug "$method $(base_url)${path}${suffix}"
    code="$(http_request "$method" "${path}${suffix}" "$out" "$data")"
    # shellcheck disable=SC2034
    REPLY_CODE="$code"
    # shellcheck disable=SC2034
    REPLY_PATH="${path}${suffix}"
    # shellcheck disable=SC2034
    REPLY_BASE="$path"
    if [[ -s "$out" ]]; then REPLY_BODY="$(cat "$out")"; else REPLY_BODY=""; fi
    debug "-> $code"
    [[ "${MEMOS_DEBUG:-0}" == "1" && -n "$REPLY_BODY" ]] && echo "[debug] body: $(printf '%s' "$REPLY_BODY" | head -c 400)" >&2 || true
    case "$code" in
      2*)
        rm -f "$out"
        return 0
        ;;
      404 | 405)
        rm -f "$out" 2> /dev/null || true
        out="$(mktemp /tmp/memos-api.XXXXXX)"
        continue
        ;;
    esac
    rm -f "$out"
    return 1
  done < <(api_paths)
  rm -f "$out"
  return 1
}

require_auth() {
  [[ -n "$MEMOS_URL" && -n "$MEMOS_TOKEN" ]] || die "MEMOS_URL and MEMOS_TOKEN must be set (see ~/.config/memo-quick/env)"
}

json_get() { # json filter
  jq -r "$1 // empty" 2> /dev/null || true
}

memo_uid_from_name() {
  local name="$1"
  printf '%s' "${name##*/}"
}

slug_uid() { # safe filename component
  printf '%s' "$1" | tr '/:' '__' | tr -cd 'A-Za-z0-9._-'
}

now_iso() { date -u +"%Y-%m-%dT%H:%M:%SZ"; }

state_get_note() {
  local uid="$1"
  jq -c --arg uid "$uid" '.notes[$uid] // empty' "$STATE_FILE" 2> /dev/null || true
}

state_upsert_note() {
  # args: uid name file remoteUpdateTime syncedContentHash [dirty] [syncedMetaHash]
  local uid="$1" name="$2" file="$3" update="$4" hash="$5" dirty="${6:-false}" meta_hash="${7:-}"
  # backward compat: if state had old syncedHash field, keep it aligned to content hash
  local tmp
  tmp="$(mktemp "${STATE_FILE}.XXXXXX")"
  jq --arg uid "$uid" --arg name "$name" --arg file "$file" --arg update "$update" --arg hash "$hash" \
    --arg mh "$meta_hash" --argjson dirty "$dirty" \
    '.notes[$uid] = ((.notes[$uid] // {}) + {name:$name,file:$file,remoteUpdateTime:$update,syncedHash:$hash,syncedContentHash:$hash,syncedMetaHash:$mh,dirty:$dirty})' \
    "$STATE_FILE" > "$tmp" && mv "$tmp" "$STATE_FILE"
}

state_mark_dirty() {
  local uid="$1" dirty="${2:-true}"
  local tmp
  tmp="$(mktemp "${STATE_FILE}.XXXXXX")"
  jq --arg uid "$uid" --argjson dirty "$dirty" \
    'if .notes[$uid] then .notes[$uid].dirty = $dirty else . end' \
    "$STATE_FILE" > "$tmp" && mv "$tmp" "$STATE_FILE"
}

state_remove_note() {
  local uid="$1"
  local tmp
  tmp="$(mktemp "${STATE_FILE}.XXXXXX")"
  jq --arg uid "$uid" 'del(.notes[$uid])' "$STATE_FILE" > "$tmp" && mv "$tmp" "$STATE_FILE"
}

content_hash() {
  printf '%s' "$1" | sha256sum | awk '{print $1}'
}

meta_string() {
  # args: visibility state pinned tags
  local visibility="${1:-PRIVATE}" mstate="${2:-NORMAL}" pinned="${3:-false}" tags="${4:-}"
  printf 'visibility=%s\nstate=%s\npinned=%s\ntags=%s\n' "$visibility" "$mstate" "$pinned" "$tags"
}

meta_hash() {
  meta_string "$1" "$2" "$3" "$4" | sha256sum | awk '{print $1}'
}

tags_to_line() {
  # stdin: json array or empty -> comma-separated
  jq -r 'if type=="array" then map(tostring) | join(",") elif type=="string" then . else "" end' 2> /dev/null || echo ""
}

file_content_hash() {
  local file="$1"
  [[ -f "$file" ]] || {
    echo ""
    return 0
  }
  local content
  content="$(sed '1{/^---$/!b};1,/^---$/d' "$file" 2> /dev/null | tr -d '\r' || tr -d '\r' < "$file")"
  if [[ "${content:0:1}" == $'\n' ]]; then content="${content#?}"; fi
  content="${content%$'\n'}"
  content_hash "$content"
}

file_hash() { # backward-compatible alias (content hash)
  file_content_hash "$1"
}

file_meta_hash() {
  local file="$1"
  [[ -f "$file" ]] || {
    echo ""
    return 0
  }
  read_mirror_file "$file" || {
    echo ""
    return 0
  }
  meta_hash "${RM_VIS:-PRIVATE}" "${RM_STATE:-NORMAL}" "${RM_PINNED:-false}" "${RM_TAGS:-}"
}

write_mirror_file() {
  # args: uid name visibility create update state content [mark_synced:true|false] [pinned] [tags]
  local uid="$1" name="$2" visibility="$3" create="$4" update="$5" mstate="$6" content="$7" mark_synced="${8:-true}" pinned="${9:-false}" tags="${10:-}"
  local file tmp
  file="$MIRROR_DIR/$(slug_uid "$uid").md"
  tmp="$(mktemp "$file.XXXXXX")"
  {
    printf '%s\n' "---"
    printf 'name: %s\n' "$name"
    printf 'uid: %s\n' "$uid"
    printf 'visibility: %s\n' "${visibility:-PRIVATE}"
    printf 'state: %s\n' "${mstate:-NORMAL}"
    printf 'pinned: %s\n' "${pinned:-false}"
    printf 'tags: %s\n' "${tags:-}"
    printf 'createTime: %s\n' "${create:-}"
    printf 'updateTime: %s\n' "${update:-}"
    printf '%s\n\n' "---"
    printf '%s' "$content"
    [[ "$content" == *$'\n' ]] || printf '\n'
  } > "$tmp"
  mv "$tmp" "$file"
  if [[ "$mark_synced" == "true" ]]; then
    state_upsert_note "$uid" "$name" "$file" "$update" "$(content_hash "$content")" false "$(meta_hash "${visibility:-PRIVATE}" "${mstate:-NORMAL}" "${pinned:-false}" "${tags:-}")"
  else
    # local change not yet synced: keep remote baseline hashes/times if any, mark dirty
    local prev_update prev_ch prev_mh
    prev_update=$(jq -r --arg uid "$uid" '.notes[$uid].remoteUpdateTime // ""' "$STATE_FILE" 2> /dev/null || echo "")
    prev_ch=$(jq -r --arg uid "$uid" '(.notes[$uid].syncedContentHash // .notes[$uid].syncedHash // "")' "$STATE_FILE" 2> /dev/null || echo "")
    prev_mh=$(jq -r --arg uid "$uid" '.notes[$uid].syncedMetaHash // ""' "$STATE_FILE" 2> /dev/null || echo "")
    [[ -z "$prev_update" ]] && prev_update="$update"
    state_upsert_note "$uid" "$name" "$file" "$prev_update" "$prev_ch" true "$prev_mh"
  fi
  printf '%s\n' "$file"
}

read_mirror_file() {
  # sets: RM_NAME RM_UID RM_VIS RM_CREATE RM_UPDATE RM_STATE RM_PINNED RM_TAGS RM_CONTENT
  local file="$1"
  RM_NAME=""
  RM_UID=""
  RM_VIS=""
  RM_CREATE=""
  RM_UPDATE=""
  RM_STATE=""
  RM_PINNED="false"
  RM_TAGS=""
  RM_CONTENT=""
  [[ -f "$file" ]] || return 1
  local in_meta=0 seen=0 line key val
  local content=""
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%$'\r'}"
    if [[ $seen -eq 0 && "$line" == "---" ]]; then
      in_meta=1
      seen=1
      continue
    fi
    if [[ $in_meta -eq 1 && "$line" == "---" ]]; then
      in_meta=0
      seen=2
      continue
    fi
    if [[ $in_meta -eq 1 ]]; then
      key="${line%%:*}"
      val="${line#*:}"
      val="${val#"${val%%[![:space:]]*}"}"
      val="${val%"${val##*[![:space:]]}"}"
      case "$key" in
        name) RM_NAME="$val" ;;
        uid) RM_UID="$val" ;;
        visibility) RM_VIS="$val" ;;
        createTime) RM_CREATE="$val" ;;
        updateTime) RM_UPDATE="$val" ;;
        state) RM_STATE="$val" ;;
        pinned) RM_PINNED="$val" ;;
        tags) RM_TAGS="$val" ;;
      esac
      continue
    fi
    if [[ $seen -eq 2 ]]; then
      content+="$line"$'\n'
    fi
  done < "$file"
  # trim single leading blank line after frontmatter and trailing extra handling kept simple
  if [[ $seen -eq 2 && "${content:0:1}" == $'\n' ]]; then content="${content#?}"; fi
  RM_CONTENT="${content%$'\n'}"
  [[ -n "$RM_UID" ]] || RM_UID="$(basename "$file" .md)"
  [[ -n "$RM_NAME" ]] || RM_NAME="memos/$RM_UID"
  [[ -n "$RM_VIS" ]] || RM_VIS="PRIVATE"
  [[ -n "$RM_STATE" ]] || RM_STATE="NORMAL"
  [[ -n "$RM_PINNED" ]] || RM_PINNED="false"
}

resolve_ref_file() {
  local ref="$1" f uid
  [[ -n "$ref" ]] || return 1
  # direct path
  if [[ -f "$ref" ]]; then
    printf '%s\n' "$ref"
    return 0
  fi
  if [[ -f "$MIRROR_DIR/$ref" ]]; then
    printf '%s\n' "$MIRROR_DIR/$ref"
    return 0
  fi
  if [[ -f "$MIRROR_DIR/$ref.md" ]]; then
    printf '%s\n' "$MIRROR_DIR/$ref.md"
    return 0
  fi
  uid="$(memo_uid_from_name "$ref")"
  if [[ -f "$MIRROR_DIR/$(slug_uid "$uid").md" ]]; then
    printf '%s\n' "$MIRROR_DIR/$(slug_uid "$uid").md"
    return 0
  fi
  # prefix/name match via state
  f=$(jq -r --arg ref "$ref" --arg uid "$uid" '
    .notes as $n | (
      [ $n[] | select(.name==$ref or .name==("memos/"+$ref) or (.name|endswith("/"+$ref))) | .file ] +
      [ $n[$uid].file ] +
      [ $n[] | select((.file|endswith("/"+$ref+".md")) or (.file|endswith("/"+$ref))) | .file ]
    ) | map(select(.!=null and .!="")) | .[0] // empty' "$STATE_FILE" 2> /dev/null || true)
  [[ -n "$f" && -f "$f" ]] && {
    printf '%s\n' "$f"
    return 0
  }
  # scan files
  f=$(find "$MIRROR_DIR" -maxdepth 1 -type f -name "*${uid}*.md" 2> /dev/null | head -n1 || true)
  [[ -n "$f" && -f "$f" ]] && {
    printf '%s\n' "$f"
    return 0
  }
  return 1
}

normalize_memo_json() {
  # stdin: memo object -> normalized json line
  jq -c '{
    name: (.name // ""),
    uid: ((.name // "") | split("/") | last),
    content: (.content // ""),
    visibility: (.visibility // "PRIVATE"),
    createTime: (.createTime // .create_time // .displayTime // .display_time // ""),
    updateTime: (.updateTime // .update_time // .displayTime // .display_time // ""),
    state: (.state // "NORMAL"),
    pinned: (if (.pinned == true) then "true" else "false" end),
    tags: (if (.tags | type) == "array" then (.tags | map(tostring) | join(",")) else (.tags // "" | tostring) end)
  }'
}

api_create_memo() {
  local content="$1" visibility="${2:-$MEMOS_VISIBILITY}"
  local payload
  # variant 1: flat
  payload=$(jq -n --arg content "$content" --arg visibility "$visibility" '{content:$content, visibility:$visibility}')
  if api_try "POST" "/memos" "$payload"; then
    printf '%s' "$REPLY_BODY"
    return 0
  fi
  # variant 2: wrapped in memo (some gRPC-gateway configs)
  payload=$(jq -n --arg content "$content" --arg visibility "$visibility" '{memo:{content:$content, visibility:$visibility}}')
  if api_try "POST" "/memos" "$payload"; then
    printf '%s' "$REPLY_BODY"
    return 0
  fi
  debug "create failed code=${REPLY_CODE:-}"
  return 1
}

api_update_memo() {
  local name="$1" content="$2" visibility="${3:-PRIVATE}" mstate="${4:-NORMAL}" pinned="${5:-false}"
  local payload uid mask
  uid="$(memo_uid_from_name "$name")"
  # normalize pinned to json bool
  local pinned_json=false
  [[ "$pinned" == "true" ]] && pinned_json=true
  mask="content,visibility,state,pinned"
  payload=$(jq -n --arg content "$content" --arg visibility "$visibility" --arg state "$mstate" --argjson pinned "$pinned_json" \
    '{content:$content, visibility:$visibility, state:$state, pinned:$pinned}')
  # variant 1: PATCH /{name} with updateMask query, flat body
  if api_try "PATCH" "/${name}?updateMask=${mask}" "$payload"; then
    printf '%s' "$REPLY_BODY"
    return 0
  fi
  # variant 2: snake_case update_mask
  if api_try "PATCH" "/${name}?update_mask=${mask}" "$payload"; then
    printf '%s' "$REPLY_BODY"
    return 0
  fi
  # variant 3: wrapped memo + updateMask in body
  payload=$(jq -n --arg name "$name" --arg content "$content" --arg visibility "$visibility" --arg state "$mstate" --argjson pinned "$pinned_json" \
    '{memo:{name:$name, content:$content, visibility:$visibility, state:$state, pinned:$pinned}, updateMask:"content,visibility,state,pinned"}')
  if api_try "PATCH" "/${name}" "$payload"; then
    printf '%s' "$REPLY_BODY"
    return 0
  fi
  # variant 4: PATCH /memos/{uid}
  payload=$(jq -n --arg content "$content" --arg visibility "$visibility" --arg state "$mstate" --argjson pinned "$pinned_json" \
    '{content:$content, visibility:$visibility, state:$state, pinned:$pinned}')
  if [[ -n "$uid" && "$uid" != "$name" ]]; then
    if api_try "PATCH" "/memos/${uid}?updateMask=${mask}" "$payload"; then
      printf '%s' "$REPLY_BODY"
      return 0
    fi
  fi
  # fallback: content+visibility only (older API compat)
  mask="content,visibility"
  payload=$(jq -n --arg content "$content" --arg visibility "$visibility" '{content:$content, visibility:$visibility}')
  if api_try "PATCH" "/${name}?updateMask=${mask}" "$payload"; then
    printf '%s' "$REPLY_BODY"
    return 0
  fi
  if api_try "PATCH" "/${name}?update_mask=${mask}" "$payload"; then
    printf '%s' "$REPLY_BODY"
    return 0
  fi
  debug "update failed code=${REPLY_CODE:-}"
  return 1
}

api_list_memos() {
  require_auth
  need_tools
  local page_token="" out first=1
  printf '['
  while :; do
    local q="/memos?pageSize=200"
    [[ -n "$page_token" ]] && q+="&pageToken=$(jq -rn --arg v "$page_token" '$v|@uri')"
    if ! api_try "GET" "$q" ""; then
      # try without pagination params
      if ! api_try "GET" "/memos" ""; then
        [[ $first -eq 1 ]] && printf ']'
        return 1
      fi
    fi
    local items ntok body
    body="$REPLY_BODY"
    # support array response or {memos:[]} or {memos:[], nextPageToken:}
    if printf '%s' "$body" | jq -e 'type=="array"' > /dev/null 2>&1; then
      items="$body"
      ntok=""
    else
      items=$(printf '%s' "$body" | jq -c '.memos // .memo // .data // []')
      ntok=$(printf '%s' "$body" | jq -r '.nextPageToken // .next_page_token // empty')
    fi
    local n i
    n=$(printf '%s' "$items" | jq 'length' 2> /dev/null || echo 0)
    i=0
    while [[ $i -lt $n ]]; do
      [[ $first -eq 0 ]] && printf ','
      printf '%s' "$items" | jq -c ".[$i]"
      first=0
      i=$((i + 1))
    done
    [[ -z "$ntok" || "$ntok" == "null" ]] && break
    page_token="$ntok"
  done
  printf ']'
}

api_delete_memo() {
  local name="$1"
  local uid
  uid="$(memo_uid_from_name "$name")"
  if api_try "DELETE" "/${name}" ""; then
    printf '%s' "${REPLY_BODY:-}"
    return 0
  fi
  if [[ -n "$uid" && "$uid" != "$name" ]]; then
    if api_try "DELETE" "/memos/${uid}" ""; then
      printf '%s' "${REPLY_BODY:-}"
      return 0
    fi
  fi
  debug "delete failed code=${REPLY_CODE:-}"
  return 1
}

pull_memos() {
  ensure_dirs
  require_auth
  need_tools
  echo "Pulling memos from $(base_url) ..." >&2
  local all
  if ! all="$(api_list_memos)"; then
    echo "Failed to list memos from API (code=${REPLY_CODE:-?}). Set MEMOS_DEBUG=1 for details." >&2
    return 1
  fi
  local count i=0 pulled=0 conflicts=0 skipped=0 deleted=0
  count=$(printf '%s' "$all" | jq 'length')
  # track seen remote uids
  declare -A seen_remote=()
  while [[ $i -lt $count ]]; do
    local m uid name content vis ctime utime mstate rpinned rtags file st_synced_ch st_synced_mh st_remote cur_ch cur_mh conflict_file ts remote_ch remote_mh
    m=$(printf '%s' "$all" | jq -c ".[$i]" | normalize_memo_json)
    uid=$(printf '%s' "$m" | json_get '.uid')
    name=$(printf '%s' "$m" | json_get '.name')
    content=$(printf '%s' "$m" | jq -r '.content // ""')
    vis=$(printf '%s' "$m" | json_get '.visibility')
    ctime=$(printf '%s' "$m" | json_get '.createTime')
    utime=$(printf '%s' "$m" | json_get '.updateTime')
    mstate=$(printf '%s' "$m" | json_get '.state')
    rpinned=$(printf '%s' "$m" | json_get '.pinned')
    rtags=$(printf '%s' "$m" | json_get '.tags')
    if [[ -z "$uid" ]]; then
      i=$((i + 1))
      continue
    fi
    seen_remote["$uid"]=1
    file="$MIRROR_DIR/$(slug_uid "$uid").md"
    st_synced_ch=$(jq -r --arg uid "$uid" '(.notes[$uid].syncedContentHash // .notes[$uid].syncedHash // "")' "$STATE_FILE" 2> /dev/null || echo "")
    st_synced_mh=$(jq -r --arg uid "$uid" '.notes[$uid].syncedMetaHash // ""' "$STATE_FILE" 2> /dev/null || echo "")
    st_remote=$(jq -r --arg uid "$uid" '.notes[$uid].remoteUpdateTime // ""' "$STATE_FILE" 2> /dev/null || echo "")
    if [[ -f "$file" ]]; then
      cur_ch="$(file_content_hash "$file")"
      cur_mh="$(file_meta_hash "$file")"
    else
      cur_ch=""
      cur_mh=""
    fi
    remote_ch="$(content_hash "$content")"
    remote_mh="$(meta_hash "$vis" "$mstate" "$rpinned" "$rtags")"

    if [[ ! -f "$file" ]]; then
      write_mirror_file "$uid" "$name" "$vis" "$ctime" "$utime" "$mstate" "$content" true "$rpinned" "$rtags" > /dev/null
      pulled=$((pulled + 1))
    elif [[ "$cur_ch" == "$st_synced_ch" && "$cur_mh" == "$st_synced_mh" ]] || [[ -z "$st_synced_ch" && -z "$st_synced_mh" ]]; then
      # local clean (or unknown baseline): take remote if different
      if [[ "$cur_ch" != "$remote_ch" || "$cur_mh" != "$remote_mh" || "$utime" != "$st_remote" ]]; then
        write_mirror_file "$uid" "$name" "$vis" "$ctime" "$utime" "$mstate" "$content" true "$rpinned" "$rtags" > /dev/null
        pulled=$((pulled + 1))
      else
        skipped=$((skipped + 1))
      fi
    else
      # local modified since last sync (content and/or metadata)
      local local_dirty_remote_same=false
      if [[ "$remote_ch" == "$st_synced_ch" && "$remote_mh" == "$st_synced_mh" && "$utime" == "$st_remote" ]]; then
        local_dirty_remote_same=true
      elif [[ -z "$st_remote" && "$remote_ch" == "$st_synced_ch" && "$remote_mh" == "$st_synced_mh" ]]; then
        local_dirty_remote_same=true
      fi
      if [[ "$local_dirty_remote_same" == "true" ]]; then
        # remote unchanged from baseline, keep local (pending push)
        skipped=$((skipped + 1))
      elif [[ "$remote_ch" == "$cur_ch" && "$remote_mh" == "$cur_mh" ]]; then
        # converged: refresh metadata/state as synced
        write_mirror_file "$uid" "$name" "$vis" "$ctime" "$utime" "$mstate" "$content" true "$rpinned" "$rtags" > /dev/null
        pulled=$((pulled + 1))
      elif [[ "$remote_ch" != "$st_synced_ch" || "$remote_mh" != "$st_synced_mh" || "$utime" != "$st_remote" ]]; then
        # CONFLICT: both changed -> keep local, save remote as conflict copy
        ts="$(date -u +%Y%m%dT%H%M%SZ)"
        conflict_file="$MIRROR_DIR/$(slug_uid "$uid").remote-conflict-${ts}.md"
        {
          printf '%s\n' "---"
          printf 'conflict: remote\n'
          printf 'name: %s\nuid: %s\nvisibility: %s\nstate: %s\npinned: %s\ntags: %s\ncreateTime: %s\nupdateTime: %s\n' "$name" "$uid" "$vis" "$mstate" "$rpinned" "$rtags" "$ctime" "$utime"
          printf '%s\n\n' "---"
          printf '%s' "$content"
          [[ "$content" == *$'\n' ]] || printf '\n'
        } > "$conflict_file"
        jq --arg uid "$uid" --arg ru "$utime" --arg file "$file" --arg name "$name" \
          '.notes[$uid] = ((.notes[$uid] // {}) + {name:$name,file:$file,remoteUpdateTime:$ru,conflict:true})' \
          "$STATE_FILE" > "${STATE_FILE}.tmp" && mv "${STATE_FILE}.tmp" "$STATE_FILE"
        conflicts=$((conflicts + 1))
        echo "Conflict: $uid -> kept local, saved remote to $conflict_file" >&2
      else
        skipped=$((skipped + 1))
      fi
    fi
    i=$((i + 1))
  done

  # detect remote deletions: notes in state that were synced from remote but missing remotely
  while IFS= read -r uid; do
    [[ -z "$uid" ]] && continue
    [[ -n "${seen_remote[$uid]+x}" ]] && continue
    local st_name st_file st_synced_ch st_synced_mh cur_ch cur_mh
    st_name=$(jq -r --arg uid "$uid" '.notes[$uid].name // ""' "$STATE_FILE" 2> /dev/null || echo "")
    st_file=$(jq -r --arg uid "$uid" '.notes[$uid].file // ""' "$STATE_FILE" 2> /dev/null || echo "")
    st_synced_ch=$(jq -r --arg uid "$uid" '(.notes[$uid].syncedContentHash // .notes[$uid].syncedHash // "")' "$STATE_FILE" 2> /dev/null || echo "")
    st_synced_mh=$(jq -r --arg uid "$uid" '.notes[$uid].syncedMetaHash // ""' "$STATE_FILE" 2> /dev/null || echo "")
    [[ -z "$st_file" ]] && st_file="$MIRROR_DIR/$(slug_uid "$uid").md"
    [[ "$st_name" == memos/* ]] || continue
    if [[ -f "$st_file" ]]; then
      cur_ch="$(file_content_hash "$st_file")"
      cur_mh="$(file_meta_hash "$st_file")"
      if { [[ "$cur_ch" == "$st_synced_ch" || -z "$st_synced_ch" ]] && [[ "$cur_mh" == "$st_synced_mh" || -z "$st_synced_mh" ]]; }; then
        rm -f "$st_file"
        state_remove_note "$uid"
        deleted=$((deleted + 1))
        echo "Removed locally (deleted remotely): $uid" >&2
      else
        # local modified but remote deleted -> conflict, keep local and mark
        jq --arg uid "$uid" '.notes[$uid] = ((.notes[$uid] // {}) + {conflict:true, remoteDeleted:true})' \
          "$STATE_FILE" > "${STATE_FILE}.tmp" && mv "${STATE_FILE}.tmp" "$STATE_FILE"
        conflicts=$((conflicts + 1))
        echo "Conflict: $uid deleted remotely but modified locally -> kept local" >&2
      fi
    else
      state_remove_note "$uid"
    fi
  done < <(jq -r '.notes | keys[]' "$STATE_FILE" 2> /dev/null)

  echo "Pulled $count memos: updated=$pulled deleted=$deleted conflicts=$conflicts unchanged=$skipped" >&2
  [[ $conflicts -eq 0 ]]
}

list_local() {
  ensure_dirs
  shopt -s nullglob
  local f count=0
  for f in "$MIRROR_DIR"/*.md; do
    read_mirror_file "$f" || continue
    local preview
    preview=$(printf '%s' "$RM_CONTENT" | tr '\n' ' ' | cut -c1-80)
    printf '%s\t%s\t%s\t%s\n' "${RM_UPDATE:-$RM_CREATE}" "${RM_UID}" "${RM_VIS:-}" "$preview"
    count=$((count + 1))
  done
  shopt -u nullglob
  [[ $count -gt 0 ]] || echo "No local mirrored notes. Run: memos pull" >&2
}

list_remote() {
  ensure_dirs
  require_auth
  need_tools
  local all m
  all="$(api_list_memos)" || die "Failed to list remote memos"
  printf '%s' "$all" | jq -r '.[] | [(.updateTime // .createTime // ""), (.name // ""), (.visibility // ""), ((.content // "") | gsub("\n"; " ") | .[0:80])] | @tsv'
}

read_note() {
  local ref="${1:-}"
  [[ -n "$ref" ]] || die "Usage: memos read <ref>"
  ensure_dirs
  local file
  if file=$(resolve_ref_file "$ref"); then
    cat "$file"
    return 0
  fi
  # fallback: try pull single? just fail clearly
  die "Note not found in local mirror: $ref (try: memos pull)"
}

enqueue_op() {
  local op="$1" payload="$2"
  need_tools
  ensure_dirs
  local line
  line=$(jq -c -n --arg op "$op" --arg ts "$(now_iso)" --argjson p "$payload" '{op:$op, ts:$ts, payload:$p}')
  printf '%s\n' "$line" >> "$QUEUE_FILE"
}

save_new_note() {
  local content="$1" visibility="${2:-$MEMOS_VISIBILITY}" mstate="${3:-NORMAL}" pinned="${4:-false}" tags="${5:-}"
  content="${content%$'\n'}"
  [[ -z "${content//[[:space:]]/}" ]] && die "Empty note, nothing to do."
  ensure_dirs

  # try create remotely first to obtain stable ID
  local created=""
  if [[ -n "$MEMOS_URL" && -n "$MEMOS_TOKEN" ]] && command -v curl > /dev/null 2>&1 && command -v jq > /dev/null 2>&1; then
    created=$(api_create_memo "$content" "$visibility" 2> /dev/null || true)
  fi

  if [[ -n "$created" ]]; then
    local m uid name ctime utime vis rmstate rpinned rtags file
    m=$(printf '%s' "$created" | normalize_memo_json)
    uid=$(printf '%s' "$m" | json_get '.uid')
    name=$(printf '%s' "$m" | json_get '.name')
    ctime=$(printf '%s' "$m" | json_get '.createTime')
    utime=$(printf '%s' "$m" | json_get '.updateTime')
    vis=$(printf '%s' "$m" | json_get '.visibility')
    rmstate=$(printf '%s' "$m" | json_get '.state')
    rpinned=$(printf '%s' "$m" | json_get '.pinned')
    rtags=$(printf '%s' "$m" | json_get '.tags')
    [[ -n "$uid" ]] || uid="local-$(date +%s)-$RANDOM"
    [[ -n "$name" ]] || name="memos/$uid"
    file=$(write_mirror_file "$uid" "$name" "$vis" "$ctime" "$utime" "$rmstate" "$content" true "$rpinned" "$rtags")
    notify "Saved & synced ($uid)"
    echo "$file"
    return 0
  fi

  # offline/failure: local draft in mirror + queue create op (dirty)
  local tmpid file
  tmpid="local-$(date +%s)-$RANDOM"
  file=$(write_mirror_file "$tmpid" "local/$tmpid" "$visibility" "$(now_iso)" "" "$mstate" "$content" false "$pinned" "$tags")
  if command -v jq > /dev/null 2>&1; then
    enqueue_op "create" "$(jq -n --arg local_uid "$tmpid" --arg content "$content" --arg visibility "$visibility" --arg state "$mstate" --arg pinned "$pinned" --arg tags "$tags" '{local_uid:$local_uid, content:$content, visibility:$visibility, state:$state, pinned:$pinned, tags:$tags}')" || true
  fi
  notify "Saved locally (queued for sync)"
  echo "$file"
  return 0
}

quick_capture() {
  local content
  if [[ $# -gt 0 ]]; then
    content="$(printf '%s' "$*")"
  elif [[ ! -t 0 ]]; then
    content="$(cat)"
  else
    echo "No input provided. Use: memos add \"text\" or pipe stdin." >&2
    exit 1
  fi
  save_new_note "$content" "$MEMOS_VISIBILITY" > /dev/null
}

new_via_editor() {
  local nvim_bin="${EDITOR_NVIM:-nvim}"
  command -v "$nvim_bin" > /dev/null 2>&1 || {
    echo "Neovim not found ($nvim_bin). Use: memos add \"text\"" >&2
    exit 1
  }

  local tmp
  tmp="$(mktemp --suffix=.md /tmp/memos-XXXXXX)"
  cleanup() { rm -f "$tmp"; }
  trap cleanup EXIT

  "$nvim_bin" \
    -c 'setlocal filetype=markdown buftype= nobuflisted' \
    -c 'startinsert' \
    "$tmp"

  if [[ -s "$tmp" ]]; then
    save_new_note "$(cat "$tmp")" "$MEMOS_VISIBILITY" > /dev/null
  fi
}

cmd_new() {
  if [[ $# -gt 0 ]]; then
    quick_capture "$@"
  elif [[ ! -t 0 ]]; then
    quick_capture
  else
    new_via_editor
  fi
}

edit_note() {
  local ref="${1:-}"
  [[ -n "$ref" ]] || die "Usage: memos edit <ref>"
  ensure_dirs
  need_tools
  local file
  file=$(resolve_ref_file "$ref") || die "Note not found in local mirror: $ref (try: memos pull)"
  read_mirror_file "$file" || die "Failed to read mirror file: $file"

  local nvim_bin="${EDITOR_NVIM:-nvim}" tmp before after_content after_hash new_content
  tmp="$(mktemp --suffix=.md /tmp/memos-edit.XXXXXX)"
  printf '%s\n' "$RM_CONTENT" > "$tmp"
  before="$(content_hash "$RM_CONTENT")"
  "${nvim_bin}" "$tmp"
  after_content="$(cat "$tmp")"
  rm -f "$tmp"
  new_content="${after_content%$'\n'}"
  after_hash="$(content_hash "$new_content")"
  # metadata edited via frontmatter is not supported in editor flow; preserve current meta
  if [[ "$before" == "$after_hash" ]]; then
    echo "No changes."
    return 0
  fi

  # write local change (dirty until synced)
  write_mirror_file "$RM_UID" "$RM_NAME" "${RM_VIS:-PRIVATE}" "$RM_CREATE" "${RM_UPDATE:-}" "${RM_STATE:-NORMAL}" "$new_content" false "${RM_PINNED:-false}" "${RM_TAGS:-}"

  # remote update if this is a synced remote note
  if [[ "$RM_NAME" == memos/* && -n "$MEMOS_URL" && -n "$MEMOS_TOKEN" ]] && command -v curl > /dev/null 2>&1; then
    local resp m utime vis rmstate rpinned rtags
    if resp=$(api_update_memo "$RM_NAME" "$new_content" "${RM_VIS:-PRIVATE}" "${RM_STATE:-NORMAL}" "${RM_PINNED:-false}" 2> /dev/null); then
      m=$(printf '%s' "$resp" | normalize_memo_json)
      utime=$(printf '%s' "$m" | json_get '.updateTime')
      vis=$(printf '%s' "$m" | json_get '.visibility')
      rmstate=$(printf '%s' "$m" | json_get '.state')
      rpinned=$(printf '%s' "$m" | json_get '.pinned')
      rtags=$(printf '%s' "$m" | json_get '.tags')
      [[ -z "$utime" ]] && utime="$(now_iso)"
      write_mirror_file "$RM_UID" "$RM_NAME" "${vis:-$RM_VIS}" "$RM_CREATE" "$utime" "${rmstate:-$RM_STATE}" "$new_content" true "${rpinned:-$RM_PINNED}" "${rtags:-$RM_TAGS}"
      notify "Updated & synced ($RM_UID)"
      echo "Updated $RM_UID"
      return 0
    fi
  fi

  # queue update for later sync
  if [[ "$RM_NAME" == memos/* ]]; then
    enqueue_op "update" "$(jq -n --arg name "$RM_NAME" --arg uid "$RM_UID" --arg content "$new_content" --arg visibility "${RM_VIS:-PRIVATE}" --arg state "${RM_STATE:-NORMAL}" --arg pinned "${RM_PINNED:-false}" --arg tags "${RM_TAGS:-}" '{name:$name, uid:$uid, content:$content, visibility:$visibility, state:$state, pinned:$pinned, tags:$tags}')" || true
    notify "Updated locally (queued for sync)"
    echo "Updated locally, queued ($RM_UID)"
  else
    notify "Updated locally"
    echo "Updated locally ($RM_UID)"
  fi
}

push_dirty_notes() {
  ensure_dirs
  need_tools
  local pushed=0 queued=0 f
  shopt -s nullglob
  for f in "$MIRROR_DIR"/*.md; do
    read_mirror_file "$f" || continue
    local uid name vis cur_ch st_ch cur_mh st_mh resp m utime rmstate rpinned rtags
    uid="$RM_UID"
    name="${RM_NAME:-memos/$uid}"
    vis="${RM_VIS:-PRIVATE}"
    [[ "$name" == memos/* ]] || continue
    cur_ch="$(file_content_hash "$f")"
    cur_mh="$(file_meta_hash "$f")"
    st_ch=$(jq -r --arg uid "$uid" '(.notes[$uid].syncedContentHash // .notes[$uid].syncedHash // "")' "$STATE_FILE" 2> /dev/null || echo "")
    st_mh=$(jq -r --arg uid "$uid" '.notes[$uid].syncedMetaHash // ""' "$STATE_FILE" 2> /dev/null || echo "")
    [[ "$cur_ch" == "$st_ch" && ("$cur_mh" == "$st_mh" || -z "$st_mh") ]] && continue
    # dirty remote-backed note (content or metadata): try direct push, else queue
    if [[ -n "$MEMOS_URL" && -n "$MEMOS_TOKEN" ]] && command -v curl > /dev/null 2>&1; then
      if resp=$(api_update_memo "$name" "$RM_CONTENT" "$vis" "${RM_STATE:-NORMAL}" "${RM_PINNED:-false}" 2> /dev/null); then
        m=$(printf '%s' "$resp" | normalize_memo_json)
        utime=$(printf '%s' "$m" | json_get '.updateTime')
        rmstate=$(printf '%s' "$m" | json_get '.state')
        rpinned=$(printf '%s' "$m" | json_get '.pinned')
        rtags=$(printf '%s' "$m" | json_get '.tags')
        [[ -z "$utime" ]] && utime="$(now_iso)"
        write_mirror_file "$uid" "$name" "${vis}" "$RM_CREATE" "$utime" "${rmstate:-$RM_STATE}" "$RM_CONTENT" true "${rpinned:-$RM_PINNED}" "${rtags:-$RM_TAGS}"
        pushed=$((pushed + 1))
        continue
      fi
    fi
    enqueue_op "update" "$(jq -n --arg name "$name" --arg uid "$uid" --arg content "$RM_CONTENT" --arg visibility "$vis" --arg state "${RM_STATE:-NORMAL}" --arg pinned "${RM_PINNED:-false}" --arg tags "${RM_TAGS:-}" '{name:$name, uid:$uid, content:$content, visibility:$visibility, state:$state, pinned:$pinned, tags:$tags}')" || true
    queued=$((queued + 1))
  done
  shopt -u nullglob
  [[ $pushed -gt 0 || $queued -gt 0 ]] && echo "Dirty notes: pushed=$pushed queued=$queued" >&2 || true
  return 0
}

flush_queue() {
  ensure_dirs
  need_tools
  [[ -f "$QUEUE_FILE" ]] || {
    echo "Queue empty."
    return 0
  }
  require_auth || true
  local tmp ok=0 fail=0 line op
  tmp="$(mktemp "${QUEUE_FILE}.XXXXXX")"
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" ]] && continue
    op=$(printf '%s' "$line" | jq -r '.op // "create"')
    case "$op" in
      create)
        local content vis luid resp m uid name ctime utime mstate rpinned rtags
        content=$(printf '%s' "$line" | jq -r '.payload.content // .content // empty')
        vis=$(printf '%s' "$line" | jq -r '.payload.visibility // .visibility // "PRIVATE"')
        luid=$(printf '%s' "$line" | jq -r '.payload.local_uid // empty')
        if [[ -n "$content" ]] && resp=$(api_create_memo "$content" "$vis" 2> /dev/null); then
          m=$(printf '%s' "$resp" | normalize_memo_json)
          uid=$(printf '%s' "$m" | json_get '.uid')
          name=$(printf '%s' "$m" | json_get '.name')
          ctime=$(printf '%s' "$m" | json_get '.createTime')
          utime=$(printf '%s' "$m" | json_get '.updateTime')
          mstate=$(printf '%s' "$m" | json_get '.state')
          rpinned=$(printf '%s' "$m" | json_get '.pinned')
          rtags=$(printf '%s' "$m" | json_get '.tags')
          [[ -z "$name" && -n "$uid" ]] && name="memos/$uid"
          if [[ -n "$uid" ]]; then
            if [[ -n "$luid" && -f "$MIRROR_DIR/$(slug_uid "$luid").md" && "$luid" != "$uid" ]]; then
              rm -f "$MIRROR_DIR/$(slug_uid "$luid").md"
              state_remove_note "$luid"
            fi
            write_mirror_file "$uid" "$name" "${vis}" "$ctime" "$utime" "$mstate" "$content" true "$rpinned" "$rtags" > /dev/null
          fi
          ok=$((ok + 1))
        else
          printf '%s\n' "$line" >> "$tmp"
          fail=$((fail + 1))
        fi
        ;;
      update)
        local name content vis uid resp m utime mstate pinned tags
        name=$(printf '%s' "$line" | jq -r '.payload.name // empty')
        content=$(printf '%s' "$line" | jq -r '.payload.content // empty')
        vis=$(printf '%s' "$line" | jq -r '.payload.visibility // "PRIVATE"')
        mstate=$(printf '%s' "$line" | jq -r '.payload.state // "NORMAL"')
        pinned=$(printf '%s' "$line" | jq -r '.payload.pinned // "false"')
        tags=$(printf '%s' "$line" | jq -r '.payload.tags // ""')
        uid=$(printf '%s' "$line" | jq -r '.payload.uid // empty')
        [[ -z "$uid" && -n "$name" ]] && uid="$(memo_uid_from_name "$name")"
        if [[ -n "$name" && "$name" == memos/* && -n "$content" ]] && resp=$(api_update_memo "$name" "$content" "$vis" "$mstate" "$pinned" 2> /dev/null); then
          m=$(printf '%s' "$resp" | normalize_memo_json)
          utime=$(printf '%s' "$m" | json_get '.updateTime')
          vis=$(printf '%s' "$m" | json_get '.visibility')
          mstate=$(printf '%s' "$m" | json_get '.state')
          pinned=$(printf '%s' "$m" | json_get '.pinned')
          tags=$(printf '%s' "$m" | json_get '.tags')
          [[ -z "$utime" ]] && utime="$(now_iso)"
          if [[ -n "$uid" && -f "$MIRROR_DIR/$(slug_uid "$uid").md" ]]; then
            read_mirror_file "$MIRROR_DIR/$(slug_uid "$uid").md" || true
            write_mirror_file "$uid" "$name" "${vis:-$RM_VIS}" "${RM_CREATE:-}" "$utime" "${mstate:-$RM_STATE}" "$content" true "${pinned:-$RM_PINNED}" "${tags:-$RM_TAGS}" > /dev/null
          fi
          ok=$((ok + 1))
        else
          printf '%s\n' "$line" >> "$tmp"
          fail=$((fail + 1))
        fi
        ;;
      delete)
        local name uid
        name=$(printf '%s' "$line" | jq -r '.payload.name // empty')
        uid=$(printf '%s' "$line" | jq -r '.payload.uid // empty')
        [[ -z "$uid" && -n "$name" ]] && uid="$(memo_uid_from_name "$name")"
        if [[ -n "$name" && "$name" == memos/* ]] && api_delete_memo "$name" > /dev/null 2>&1; then
          [[ -n "$uid" ]] && state_remove_note "$uid"
          [[ -n "$uid" && -f "$MIRROR_DIR/$(slug_uid "$uid").md" ]] && rm -f "$MIRROR_DIR/$(slug_uid "$uid").md"
          ok=$((ok + 1))
        else
          # if already gone (404), treat as success
          if [[ "${REPLY_CODE:-}" == "404" ]]; then
            [[ -n "$uid" ]] && state_remove_note "$uid"
            [[ -n "$uid" && -f "$MIRROR_DIR/$(slug_uid "$uid").md" ]] && rm -f "$MIRROR_DIR/$(slug_uid "$uid").md"
            ok=$((ok + 1))
          else
            printf '%s\n' "$line" >> "$tmp"
            fail=$((fail + 1))
          fi
        fi
        ;;
      *)
        printf '%s\n' "$line" >> "$tmp"
        fail=$((fail + 1))
        ;;
    esac
  done < "$QUEUE_FILE"

  if [[ -s "$tmp" ]]; then mv "$tmp" "$QUEUE_FILE"; else rm -f "$tmp" "$QUEUE_FILE"; fi
  echo "Flushed queue: ok=$ok failed=$fail"
  [[ $fail -eq 0 ]]
}

cmd_push() {
  ensure_dirs
  local rc=0
  push_dirty_notes || rc=$?
  flush_queue || rc=$?
  return $rc
}

cmd_sync() {
  ensure_dirs
  local rc=0
  push_dirty_notes || rc=$?
  flush_queue || rc=$?
  pull_memos || rc=$?
  return $rc
}

list_conflicts() {
  ensure_dirs
  need_tools
  local found=0 uid file flag rdel st_name
  echo "Conflicts (state):"
  while IFS= read -r uid; do
    [[ -z "$uid" ]] && continue
    flag=$(jq -r --arg uid "$uid" '.notes[$uid].conflict // false' "$STATE_FILE" 2> /dev/null || echo false)
    rdel=$(jq -r --arg uid "$uid" '.notes[$uid].remoteDeleted // false' "$STATE_FILE" 2> /dev/null || echo false)
    st_name=$(jq -r --arg uid "$uid" '.notes[$uid].name // ""' "$STATE_FILE" 2> /dev/null || echo "")
    file=$(jq -r --arg uid "$uid" '.notes[$uid].file // ""' "$STATE_FILE" 2> /dev/null || echo "")
    if [[ "$flag" == "true" || "$rdel" == "true" ]]; then
      printf '  %s\tname=%s\tremoteDeleted=%s\tfile=%s\n' "$uid" "$st_name" "$rdel" "$file"
      found=1
    fi
  done < <(jq -r '.notes | keys[]' "$STATE_FILE" 2> /dev/null)
  [[ $found -eq 1 ]] || echo "  (none)"
  echo "Conflict copies:"
  shopt -s nullglob
  local c foundc=0
  for c in "$MIRROR_DIR"/*.remote-conflict-*.md; do
    printf '  %s\n' "$(basename "$c")"
    foundc=1
  done
  shopt -u nullglob
  [[ $foundc -eq 1 ]] || echo "  (none)"
}

latest_conflict_file_for_uid() {
  local uid="$1"
  local f latest=""
  shopt -s nullglob
  for f in "$MIRROR_DIR/${uid}.remote-conflict-"*.md; do
    if [[ -z "$latest" || "$f" -nt "$latest" ]]; then
      latest="$f"
    fi
  done
  shopt -u nullglob
  printf '%s\n' "$latest"
}

resolve_note() {
  local ref="${1:-}" mode="${2:-}"
  [[ -n "$ref" && -n "$mode" ]] || die "Usage: memos resolve <ref> --keep-local|--keep-remote"
  case "$mode" in
    --keep-local | --keep-remote) ;;
    *) die "Usage: memos resolve <ref> --keep-local|--keep-remote" ;;
  esac
  ensure_dirs
  need_tools
  local file uid name
  file=$(resolve_ref_file "$ref") || die "Note not found in local mirror: $ref"
  read_mirror_file "$file" || die "Failed to read mirror file: $file"
  uid="$RM_UID"
  name="${RM_NAME:-memos/$uid}"
  local rdel
  rdel=$(jq -r --arg uid "$uid" '.notes[$uid].remoteDeleted // false' "$STATE_FILE" 2> /dev/null || echo false)

  if [[ "$mode" == "--keep-remote" ]]; then
    if [[ "$rdel" == "true" ]]; then
      rm -f "$file" "$MIRROR_DIR/${uid}.remote-conflict-"*.md 2> /dev/null || true
      state_remove_note "$uid"
      notify "Resolved ($uid): kept remote deletion"
      echo "Resolved $uid: removed local copy (remote deleted)"
      return 0
    fi
    local cf
    cf="$(latest_conflict_file_for_uid "$uid")"
    if [[ -z "$cf" || ! -f "$cf" ]]; then
      echo "No remote conflict copy found for $uid; pulling..." >&2
      pull_memos || true
      cf="$(latest_conflict_file_for_uid "$uid")"
    fi
    [[ -f "$cf" ]] || die "Cannot resolve $uid: no remote conflict copy available"
    read_mirror_file "$cf" || die "Failed to read conflict file: $cf"
    # restore remote version as synced
    write_mirror_file "$uid" "${RM_NAME:-$name}" "${RM_VIS:-PRIVATE}" "${RM_CREATE:-}" "${RM_UPDATE:-}" "${RM_STATE:-NORMAL}" "$RM_CONTENT" true "${RM_PINNED:-false}" "${RM_TAGS:-}" > /dev/null
    rm -f "$MIRROR_DIR/${uid}.remote-conflict-"*.md 2> /dev/null || true
    jq --arg uid "$uid" 'if .notes[$uid] then .notes[$uid].conflict=false | .notes[$uid].remoteDeleted=false else . end' "$STATE_FILE" > "${STATE_FILE}.tmp" && mv "${STATE_FILE}.tmp" "$STATE_FILE"
    notify "Resolved ($uid): kept remote"
    echo "Resolved $uid: kept remote version"
    return 0
  fi

  # --keep-local
  rm -f "$MIRROR_DIR/${uid}.remote-conflict-"*.md 2> /dev/null || true
  jq --arg uid "$uid" 'if .notes[$uid] then .notes[$uid].conflict=false else . end' "$STATE_FILE" > "${STATE_FILE}.tmp" && mv "${STATE_FILE}.tmp" "$STATE_FILE"
  if [[ "$rdel" == "true" ]]; then
    # remote deleted: recreate as new remote note with same content
    if [[ -n "$MEMOS_URL" && -n "$MEMOS_TOKEN" ]] && command -v curl > /dev/null 2>&1; then
      local created m new_uid new_name ctime utime vis mstate rpinned rtags
      created=$(api_create_memo "$RM_CONTENT" "${RM_VIS:-PRIVATE}" 2> /dev/null || true)
      if [[ -n "$created" ]]; then
        m=$(printf '%s' "$created" | normalize_memo_json)
        new_uid=$(printf '%s' "$m" | json_get '.uid')
        new_name=$(printf '%s' "$m" | json_get '.name')
        ctime=$(printf '%s' "$m" | json_get '.createTime')
        utime=$(printf '%s' "$m" | json_get '.updateTime')
        vis=$(printf '%s' "$m" | json_get '.visibility')
        mstate=$(printf '%s' "$m" | json_get '.state')
        rpinned=$(printf '%s' "$m" | json_get '.pinned')
        rtags=$(printf '%s' "$m" | json_get '.tags')
        [[ -z "$new_name" && -n "$new_uid" ]] && new_name="memos/$new_uid"
        if [[ -n "$new_uid" ]]; then
          rm -f "$file"
          state_remove_note "$uid"
          write_mirror_file "$new_uid" "$new_name" "$vis" "$ctime" "$utime" "$mstate" "$RM_CONTENT" true "$rpinned" "$rtags" > /dev/null
          notify "Resolved ($uid): recreated remotely as $new_uid"
          echo "Resolved $uid: recreated as $new_uid (remote was deleted)"
          return 0
        fi
      fi
    fi
    # fallback: convert to local draft queued for create
    local tmpid
    tmpid="local-$(date +%s)-$RANDOM"
    rm -f "$file"
    state_remove_note "$uid"
    write_mirror_file "$tmpid" "local/$tmpid" "${RM_VIS:-PRIVATE}" "$(now_iso)" "" "${RM_STATE:-NORMAL}" "$RM_CONTENT" false "${RM_PINNED:-false}" "${RM_TAGS:-}" > /dev/null
    enqueue_op "create" "$(jq -n --arg local_uid "$tmpid" --arg content "$RM_CONTENT" --arg visibility "${RM_VIS:-PRIVATE}" --arg state "${RM_STATE:-NORMAL}" --arg pinned "${RM_PINNED:-false}" --arg tags "${RM_TAGS:-}" '{local_uid:$local_uid, content:$content, visibility:$visibility, state:$state, pinned:$pinned, tags:$tags}')" || true
    notify "Resolved ($uid): kept local (queued recreate)"
    echo "Resolved $uid: kept local as $tmpid (queued recreate)"
    return 0
  fi

  # normal conflict: keep local, mark dirty and try to push on next sync/push
  jq --arg uid "$uid" '.notes[$uid].dirty = true' "$STATE_FILE" > "${STATE_FILE}.tmp" && mv "${STATE_FILE}.tmp" "$STATE_FILE"
  notify "Resolved ($uid): kept local (will push on sync)"
  echo "Resolved $uid: kept local version (run memos sync/push to send local)"
  return 0
}

delete_note() {
  local ref="${1:-}"
  [[ -n "$ref" ]] || die "Usage: memos rm <ref>"
  ensure_dirs
  need_tools
  local file uid name
  file=$(resolve_ref_file "$ref") || die "Note not found in local mirror: $ref"
  read_mirror_file "$file" || die "Failed to read mirror file: $file"
  uid="$RM_UID"
  name="${RM_NAME:-memos/$uid}"

  # remove local artifacts
  rm -f "$file"
  rm -f "$MIRROR_DIR/${uid}.remote-conflict-"*.md 2> /dev/null || true

  if [[ "$name" == memos/* && -n "$MEMOS_URL" && -n "$MEMOS_TOKEN" ]] && command -v curl > /dev/null 2>&1; then
    if api_delete_memo "$name" > /dev/null 2>&1; then
      state_remove_note "$uid"
      notify "Deleted ($uid)"
      echo "Deleted $uid"
      return 0
    elif [[ "${REPLY_CODE:-}" == "404" ]]; then
      state_remove_note "$uid"
      notify "Deleted locally (already gone remotely: $uid)"
      echo "Deleted locally ($uid, remote already gone)"
      return 0
    fi
  fi

  if [[ "$name" == memos/* ]]; then
    state_remove_note "$uid"
    enqueue_op "delete" "$(jq -n --arg name "$name" --arg uid "$uid" '{name:$name, uid:$uid}')" || true
    notify "Deleted locally (queued remote delete)"
    echo "Deleted locally, queued remote delete ($uid)"
  else
    state_remove_note "$uid"
    notify "Deleted locally ($uid)"
    echo "Deleted locally ($uid)"
  fi
}

print_completion() {
  local shell="${1:-}"
  case "$shell" in
    bash)
      cat << 'EOF'
_memos_completions() {
  local cur prev words cword
  _init_completion -s || return
  local subcmds="new add quick sync flush list read edit rm delete conflicts resolve pull push completion help"
  if [[ $cword -eq 1 ]]; then
    COMPREPLY=( $(compgen -W "${subcmds} -h --help" -- "$cur") )
    return
  fi
  prev="${words[1]}"
  case "$prev" in
    completion)
      [[ $cword -eq 2 ]] && COMPREPLY=( $(compgen -W "bash zsh fish" -- "$cur") )
      ;;
    read | edit | rm | delete)
      if [[ -d "${MEMOS_NOTES_DIR:-$HOME/notes/memos}/notes" ]]; then
        local files
        files=$(cd "${MEMOS_NOTES_DIR:-$HOME/notes/memos}/notes" 2>/dev/null && ls *.md 2>/dev/null | sed 's/\.md$//')
        COMPREPLY=( $(compgen -W "$files" -- "$cur") )
      fi
      ;;
  esac
}
complete -F _memos_completions memos memo-quick memo-nvim
EOF
      ;;
    zsh)
      cat << 'EOF'
#compdef memos memo-quick memo-nvim

_memos() {
  local -a subcmds
  subcmds=(
    'new:Create a new note (editor or text/stdin)'
    'add:Quick-create a new note from args or stdin'
    'quick:Alias for quick-create'
    'list:List notes (local mirror or --remote)'
    'read:Read a note by id/name'
    'edit:Edit a note and push update'
    'rm:Delete a note'
    'delete:Delete a note (alias)'
    'conflicts:List notes with sync conflicts'
    'resolve:Resolve a conflict (--keep-local|--keep-remote)'
    'pull:Pull remote memos into local mirror'
    'push:Push local changes (dirty + queue)'
    'sync:Reconcile (push local + pull)'
    'flush:Flush outbound queue only'
    'completion:Print shell completion script'
    'help:Show help'
  )

  _arguments -C \
    '1: :->cmd' \
    '*::arg:->args' && return

  case $state in
    cmd)
      _describe -t commands 'memos command' subcmds
      _values 'options' '-h[Show help]' '--help[Show help]'
      ;;
    args)
      case $words[1] in
        completion) _values 'shell' bash zsh fish ;;
        list) _values 'opts' '--remote[List from API]' ;;
        read|edit|rm|delete|resolve)
          local -a notes
          local ndir="${MEMOS_NOTES_DIR:-$HOME/notes/memos}/notes"
          [[ -d "$ndir" ]] && notes=(${ndir}/*.md(:t:r))
          if [[ $words[1] == resolve && ${#words[@]} -eq 3 ]]; then
            _values 'mode' --keep-local --keep-remote
          else
            (( ${#notes} )) && _values 'note' $notes
          fi
          ;;
        new|add|quick) _message 'note text (or stdin)' ;;
      esac
      ;;
  esac
}

compdef _memos memos memo-quick memo-nvim
EOF
      ;;
    fish)
      cat << 'EOF'
complete -c memos -f
complete -c memos -n "__fish_use_subcommand" -a "new" -d "Create a new note"
complete -c memos -n "__fish_use_subcommand" -a "add" -d "Quick-create a new note"
complete -c memos -n "__fish_use_subcommand" -a "quick" -d "Alias for quick-create"
complete -c memos -n "__fish_use_subcommand" -a "list" -d "List notes"
complete -c memos -n "__fish_use_subcommand" -a "read" -d "Read a note"
complete -c memos -n "__fish_use_subcommand" -a "edit" -d "Edit a note and push update"
complete -c memos -n "__fish_use_subcommand" -a "rm" -d "Delete a note"
complete -c memos -n "__fish_use_subcommand" -a "delete" -d "Delete a note (alias)"
complete -c memos -n "__fish_use_subcommand" -a "conflicts" -d "List notes with sync conflicts"
complete -c memos -n "__fish_use_subcommand" -a "resolve" -d "Resolve a conflict"
complete -c memos -n "__fish_use_subcommand" -a "pull" -d "Pull remote memos into local mirror"
complete -c memos -n "__fish_use_subcommand" -a "push" -d "Push local changes (dirty + queue)"
complete -c memos -n "__fish_use_subcommand" -a "sync" -d "Reconcile (push local + pull)"
complete -c memos -n "__fish_use_subcommand" -a "flush" -d "Flush outbound queue only"
complete -c memos -n "__fish_use_subcommand" -a "completion" -d "Print shell completion script"
complete -c memos -n "__fish_use_subcommand" -a "help" -d "Show help"
complete -c memos -n "__fish_seen_subcommand_from completion" -a "bash zsh fish"
complete -c memos -n "__fish_seen_subcommand_from list" -l remote -d "List from API"
complete -c memo-quick -w memos
complete -c memo-nvim -w memos
EOF
      ;;
    "")
      echo "Usage: memos completion <bash|zsh|fish>" >&2
      exit 1
      ;;
    *)
      echo "Unsupported shell: $shell (supported: bash, zsh, fish)" >&2
      exit 1
      ;;
  esac
}

main() {
  local cmd="${1:-}"
  case "$cmd" in
    help | -h | --help)
      usage
      exit 0
      ;;
    sync)
      cmd_sync
      exit $?
      ;;
    push)
      cmd_push
      exit $?
      ;;
    flush)
      flush_queue
      exit $?
      ;;
    pull)
      pull_memos
      exit $?
      ;;
    list)
      shift
      if [[ "${1:-}" == "--remote" ]]; then list_remote; else list_local; fi
      exit 0
      ;;
    read)
      shift
      read_note "${1:-}"
      exit 0
      ;;
    edit)
      shift
      edit_note "${1:-}"
      exit 0
      ;;
    rm | delete)
      shift
      delete_note "${1:-}"
      exit 0
      ;;
    conflicts)
      list_conflicts
      exit 0
      ;;
    resolve)
      shift
      resolve_note "${1:-}" "${2:-}"
      exit 0
      ;;
    completion)
      shift
      print_completion "${1:-}"
      exit 0
      ;;
    new)
      shift
      cmd_new "$@"
      ;;
    add | quick)
      shift
      quick_capture "$@"
      ;;
    "") new_via_editor ;;
    *) quick_capture "$@" ;;
  esac
}

main "$@"
