#!/usr/bin/env bash
set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/memo-quick"
ENV_FILE="$CONFIG_DIR/env"
NOTES_DIR_DEFAULT="${HOME}/notes/memos"
LOG_TAG="memos"

# shellcheck disable=SC1090
[[ -f "$ENV_FILE" ]] && source "$ENV_FILE"

MEMOS_URL="${MEMOS_URL:-}"
MEMOS_TOKEN="${MEMOS_TOKEN:-}"
MEMOS_VISIBILITY="${MEMOS_VISIBILITY:-PRIVATE}"
# Optional: force API path, e.g. /api/memos or /api/v1/memos
MEMOS_API_PATH="${MEMOS_API_PATH:-}"
NOTES_DIR="${MEMOS_NOTES_DIR:-$NOTES_DIR_DEFAULT}"
QUEUE_FILE="$NOTES_DIR/.queue.jsonl"

usage() {
  cat << 'EOF'
Usage:
  memos                      Open Neovim scratchpad and create a new note
  memos new [text...]        Create a new note (editor if no text/stdin, else quick)
  memos add [text...]        Quick-create a new note from args or stdin
  memos quick [text...]      Alias for quick-create
  memos "text"               Shorthand quick-create (unknown non-command arg)
  echo "text" | memos new    Create a new note from stdin
  memos sync|flush           Flush offline queue (.queue.jsonl)
  memos help|-h|--help       Show this help

Compatibility: memo-quick and memo-nvim are wrappers around this command.

Environment (from ~/.config/memo-quick/env by default):
  MEMOS_URL        Base URL, e.g. https://memos.example.com
  MEMOS_TOKEN      Personal Access Token (Bearer)
  MEMOS_VISIBILITY PRIVATE|PROTECTED|PUBLIC (default: PRIVATE)
  MEMOS_API_PATH   Optional fixed path (e.g. /api/memos or /api/v1/memos)
  MEMOS_NOTES_DIR  Local archive dir (default: ~/notes/memos)
EOF
}

notify() {
  local msg="$1"
  if command -v notify-send > /dev/null 2>&1; then
    notify-send -a "$LOG_TAG" "$LOG_TAG" "$msg" > /dev/null 2>&1 || true
  fi
}

ensure_dirs() {
  mkdir -p "$NOTES_DIR" "$CONFIG_DIR"
}

api_post() {
  local content="$1"
  [[ -z "$MEMOS_URL" || -z "$MEMOS_TOKEN" ]] && return 1
  command -v curl > /dev/null 2>&1 || return 1
  command -v jq > /dev/null 2>&1 || return 1

  local base="${MEMOS_URL%/}"
  local payload
  payload=$(jq -n --arg content "$content" --arg visibility "$MEMOS_VISIBILITY" '{content:$content, visibility:$visibility}')

  local paths=()
  if [[ -n "$MEMOS_API_PATH" ]]; then
    paths+=("$MEMOS_API_PATH")
  else
    paths+=("/api/memos" "/api/v1/memos")
  fi

  local path http code
  for path in "${paths[@]}"; do
    http=$(curl -sS -o /tmp/memos-resp.$$ -w '%{http_code}' \
      -X POST "${base}${path}" \
      -H "Authorization: Bearer ${MEMOS_TOKEN}" \
      -H "Content-Type: application/json" \
      -d "$payload" 2> /dev/null) || continue
    code="${http:-000}"
    if [[ "$code" =~ ^2 ]]; then
      rm -f /tmp/memos-resp.$$
      return 0
    fi
  done
  rm -f /tmp/memos-resp.$$
  return 1
}

enqueue() {
  local content="$1"
  command -v jq > /dev/null 2>&1 || return 1
  local line
  line=$(jq -c -n --arg content "$content" --arg visibility "$MEMOS_VISIBILITY" --arg ts "$(date -Iseconds)" '{content:$content, visibility:$visibility, created_at:$ts}')
  printf '%s\n' "$line" >> "$QUEUE_FILE"
}

flush_queue() {
  ensure_dirs
  [[ -f "$QUEUE_FILE" ]] || {
    echo "Queue empty."
    exit 0
  }
  command -v jq > /dev/null 2>&1 || {
    echo "jq required" >&2
    exit 1
  }

  local tmp ok=0 fail=0 line content vis old_vis
  tmp="$(mktemp "${QUEUE_FILE}.XXXXXX")"
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" ]] && continue
    content=$(printf '%s' "$line" | jq -r '.content // empty' 2> /dev/null || true)
    vis=$(printf '%s' "$line" | jq -r '.visibility // empty' 2> /dev/null || true)
    if [[ -z "$content" ]]; then
      continue
    fi
    old_vis="$MEMOS_VISIBILITY"
    [[ -n "$vis" ]] && MEMOS_VISIBILITY="$vis"
    if api_post "$content"; then
      ok=$((ok + 1))
    else
      printf '%s\n' "$line" >> "$tmp"
      fail=$((fail + 1))
    fi
    MEMOS_VISIBILITY="$old_vis"
  done < "$QUEUE_FILE"

  if [[ -s "$tmp" ]]; then
    mv "$tmp" "$QUEUE_FILE"
  else
    rm -f "$tmp" "$QUEUE_FILE"
  fi

  echo "Flushed: ok=$ok failed=$fail"
  [[ $fail -eq 0 ]]
}

append_local() {
  local content="$1"
  ensure_dirs
  local daily_file ts
  daily_file="$NOTES_DIR/$(date +%F).md"
  ts="$(date +%H:%M)"
  {
    printf '\n## %s\n\n' "$ts"
    printf '%s\n' "$content"
  } >> "$daily_file"
}

save_note() {
  local content="$1"
  content="${content%$'\n'}"
  [[ -z "${content//[[:space:]]/}" ]] && {
    echo "Empty note, nothing to do." >&2
    exit 1
  }

  append_local "$content"

  if api_post "$content"; then
    notify "Saved & synced"
    exit 0
  else
    enqueue "$content" || true
    notify "Saved locally (queued for sync)"
    exit 0
  fi
}

quick_capture() {
  local content
  if [[ $# -gt 0 ]]; then
    content="$(printf '%s' "$*")"
  elif [[ ! -t 0 ]]; then
    content="$(cat)"
  else
    echo "No input provided. Use: memos add \"text\" or pipe stdin." >&2
    exit 1
  fi
  save_note "$content"
}

new_via_editor() {
  local nvim_bin="${EDITOR_NVIM:-nvim}"
  command -v "$nvim_bin" > /dev/null 2>&1 || {
    echo "Neovim not found ($nvim_bin). Use: memos add \"text\"" >&2
    exit 1
  }

  local tmp
  tmp="$(mktemp --suffix=.md /tmp/memos-XXXXXX)"
  cleanup() { rm -f "$tmp"; }
  trap cleanup EXIT

  "$nvim_bin" \
    -c 'setlocal filetype=markdown buftype= nobuflisted' \
    -c 'startinsert' \
    "$tmp"

  if [[ -s "$tmp" ]]; then
    save_note "$(cat "$tmp")"
  fi
}

cmd_new() {
  if [[ $# -gt 0 ]]; then
    quick_capture "$@"
  elif [[ ! -t 0 ]]; then
    quick_capture
  else
    new_via_editor
  fi
}

is_subcommand() {
  case "${1:-}" in
    new | add | quick | sync | flush | help | -h | --help | list | read | edit | pull | push) return 0 ;;
    *) return 1 ;;
  esac
}

main() {
  local cmd="${1:-}"

  case "$cmd" in
    help | -h | --help)
      usage
      exit 0
      ;;
    sync | flush)
      flush_queue
      exit $?
      ;;
    list | read | edit | pull | push)
      echo "Command '$cmd' is not implemented yet (planned for bidirectional sync/edit)." >&2
      echo "See docs/PRD.md and docs/MANUAL.md." >&2
      exit 2
      ;;
    new)
      shift
      cmd_new "$@"
      ;;
    add | quick)
      shift
      quick_capture "$@"
      ;;
    "")
      new_via_editor
      ;;
    *)
      # Unknown first arg: treat as quick-create text (shorthand: memos "text")
      quick_capture "$@"
      ;;
  esac
}

main "$@"
