#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
MEMOS_BIN="${MEMOS_BIN:-$SCRIPT_DIR/memos}"
if [[ ! -x "$MEMOS_BIN" ]] && command -v memos > /dev/null 2>&1; then
  MEMOS_BIN="$(command -v memos)"
fi

case "${1:-}" in
  -h | --help)
    exec "$MEMOS_BIN" help
    ;;
  --flush | --sync)
    exec "$MEMOS_BIN" sync
    ;;
  *)
    if [[ $# -gt 0 ]]; then
      exec "$MEMOS_BIN" add "$@"
    elif [[ ! -t 0 ]]; then
      exec "$MEMOS_BIN" add
    else
      exec "$MEMOS_BIN" help
    fi
    ;;
esac
